---
export interface FeaturedProjectData {
  title: string;
  description: string;
  status?: string;
  tags: string[];
  github?: string;
}

interface Props {
  project: FeaturedProjectData;
}

const { project } = Astro.props;
const statusLabel = project.status === "in-progress" ? "In progress" : project.status;
---

<section class="featured-block" aria-labelledby="featured-section-heading">
  <h2 id="featured-section-heading" class="section-heading">Featured Project</h2>
  <div class="featured">
    <h3 id="featured-heading">{project.title}</h3>
    {
      statusLabel ? (
        <p class="featured__status">{statusLabel}</p>
      ) : null
    }
    <p class="featured__desc">{project.description}</p>
    {
      project.tags.length > 0 ? (
        <ul class="tag-list">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      ) : null
    }
    {
      project.github ? (
        <p class="featured__actions">
          <a class="text-link" href={project.github} rel="noreferrer">
            View on GitHub →
          </a>
        </p>
      ) : null
    }
  </div>
</section>

<style>
  .featured-block {
    min-width: 0;
  }

  .featured {
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  h3 {
    margin: 0;
    font-size: clamp(1.25rem, 1.5vw, 1.5rem);
    font-weight: 500;
    overflow-wrap: break-word;
  }

  .featured__status {
    margin: 0.4rem 0 0;
    color: var(--accent-green);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured__desc {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin: 0.85rem 0 0;
  }

  @media (min-width: 64rem) {
    .featured {
      padding: 1rem 1.1rem;
      background: var(--surface-raised);
    }
  }
</style>
