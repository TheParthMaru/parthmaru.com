---
import heroImage from "../../assets/hero-image.jpg";

interface Props {
  latestArticleHref?: string;
}

const { latestArticleHref } = Astro.props;

const intro =
  "I build backend systems and document what I learn while building them.";
---

<section class="hero" aria-labelledby="hero-name">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">Ideas / Code / Systems / Progress</p>
      <h1 id="hero-name">Parth Maru</h1>
      <p class="hero__role">Backend Engineer · Python · Cloud · AI</p>
      <p class="hero__intro">{intro}</p>
      <p class="hero__actions">
        <a class="button-primary" href="/projects">See my work →</a>
        {
          latestArticleHref ? (
            <a class="text-link" href={latestArticleHref}>
              Read latest article →
            </a>
          ) : null
        }
      </p>
    </div>

    <div class="hero__visual">
      <img
        src={heroImage.src}
        alt=""
        width={heroImage.width}
        height={heroImage.height}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(1rem, 1.6vw, 1.35rem);
    padding-bottom: 0;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.25rem;
  }

  .hero__copy {
    min-width: 0;
    max-width: 100%;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-hero);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    overflow-wrap: break-word;
  }

  .hero__role {
    margin: 0.85rem 0 0;
    color: var(--text);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.45;
  }

  .hero__intro {
    max-width: 34rem;
    margin: 1.05rem 0 0;
    color: var(--text-muted);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: var(--leading-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin: 1.45rem 0 0;
  }

  .hero__visual {
    width: 100%;
    min-width: 0;
    min-height: 12.5rem;
  }

  .hero__visual img {
    width: 100%;
    height: 100%;
    min-height: 12.5rem;
    object-fit: cover;
    object-position: center 40%;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 18%);
  }

  @media (min-width: 40rem) {
    .hero__eyebrow {
      letter-spacing: var(--tracking-wide);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: 0;
    }

    .hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 42%) minmax(0, 58%);
      grid-template-rows: minmax(clamp(26rem, 34vw, 34rem), auto);
      align-items: stretch;
      gap: 0;
      min-height: clamp(26rem, 34vw, 34rem);
    }

    .hero__copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: none;
      padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 2.4vw, 2.75rem)
        clamp(1.5rem, 3vw, 2.5rem) 0;
    }

    .hero__intro {
      max-width: 38rem;
    }

    .hero__role {
      font-size: clamp(1.05rem, 1.05vw, 1.3rem);
    }

    .hero__visual {
      display: grid;
      min-height: clamp(26rem, 34vw, 34rem);
    }

    .hero__visual img {
      width: 100%;
      height: 100%;
      min-height: clamp(26rem, 34vw, 34rem);
      object-fit: cover;
      object-position: 58% 42%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 10%);
    }
  }
</style>
