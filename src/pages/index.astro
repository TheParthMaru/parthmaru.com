---
import Closing from "../components/home/Closing.astro";
import Currently from "../components/home/Currently.astro";
import FeaturedProject from "../components/home/FeaturedProject.astro";
import Hero from "../components/home/Hero.astro";
import ProjectList from "../components/home/ProjectList.astro";
import RecentWriting from "../components/home/RecentWriting.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedProjects, projectDestination, projectUrl } from "../lib/projects";
import { getPublishedWriting, writingPath } from "../lib/writing";

const publishedProjects = await getPublishedProjects();
const featuredEntry = publishedProjects.find((entry) => entry.data.featured);
const recentProjects = publishedProjects
	.filter((entry) => !entry.data.featured)
	.map((entry) => ({
		title: entry.data.title,
		description: entry.data.description,
		tags: entry.data.tags,
		href: projectDestination(entry.data.github, entry.data.demo),
	}));

const publishedWriting = await getPublishedWriting();
const latestArticleHref = publishedWriting[0]
	? writingPath(publishedWriting[0])
	: undefined;
const articles = publishedWriting.slice(0, 4).map((entry) => ({
	id: entry.id,
	title: entry.data.title,
	date: entry.data.date,
	description: entry.data.description,
	tags: entry.data.tags,
}));

const featured = featuredEntry
	? {
			title: featuredEntry.data.title,
			description: featuredEntry.data.description,
			status: featuredEntry.data.status,
			tags: featuredEntry.data.tags,
			github: projectUrl(featuredEntry.data.github),
		}
	: undefined;
---

<BaseLayout>
	<Hero latestArticleHref={latestArticleHref} />
	<Currently />
	<section class="work" aria-label="Selected work and writing">
		<div class="container work__grid">
			<ProjectList projects={recentProjects} />
			{
				featured ? (
					<FeaturedProject project={featured} />
				) : (
					<p class="empty-note">No featured project yet.</p>
				)
			}
			<RecentWriting articles={articles} notesUrl={site.notesUrl || undefined} />
		</div>
	</section>
	<Closing />
</BaseLayout>

<style>
	.work {
		padding-block: var(--space-4) var(--space-7);
		border-top: 1px solid var(--border);
	}

	.work__grid {
		display: grid;
		gap: var(--space-7);
	}

	.work__grid > * {
		min-width: 0;
	}

	@media (min-width: 64rem) {
		.work {
			padding-block: var(--space-4) var(--space-5);
		}
	}

	@media (min-width: 75rem) {
		.work__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr);
			gap: var(--space-5) var(--space-5);
			align-items: start;
		}

		.work__grid > :nth-child(1),
		.work__grid > :nth-child(2) {
			padding-right: var(--space-5);
			border-right: 1px solid var(--border);
		}
	}
</style>
