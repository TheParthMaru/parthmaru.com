---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	formatProjectStatus,
	getPublishedProjects,
	projectUrl,
} from "../../lib/projects";

const projects = await getPublishedProjects();
---

<BaseLayout title="Projects — Parth Maru" description="Projects by Parth Maru.">
	<section class="project-index" aria-labelledby="projects-heading">
		<div class="container">
			<h1 id="projects-heading" class="section-heading">Projects</h1>
			{
				projects.length === 0 ? (
					<p class="empty-note">No published projects yet.</p>
				) : (
					<ul>
						{projects.map((project) => {
							const status = formatProjectStatus(project.data.status);
							const github = projectUrl(project.data.github);
							const demo = projectUrl(project.data.demo);

							return (
								<li>
									<h2 class="project-index__title">{project.data.title}</h2>
									<p class="project-index__desc">{project.data.description}</p>
									{status ? <p class="project-index__status">{status}</p> : null}
									{project.data.tags.length > 0 ? (
										<ul class="tag-list">
											{project.data.tags.map((tag) => (
												<li>{tag}</li>
											))}
										</ul>
									) : null}
									{github || demo ? (
										<p class="project-index__links">
											{github ? (
												<a class="text-link" href={github} rel="noreferrer">
													View on GitHub →
												</a>
											) : null}
											{demo ? (
												<a class="text-link" href={demo} rel="noreferrer">
													Live demo →
												</a>
											) : null}
										</p>
									) : null}
								</li>
							);
						})}
					</ul>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	.project-index {
		padding-block: var(--space-7) var(--space-9);
	}

	.project-index ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-index li + li {
		border-top: 1px solid var(--border);
	}

	.project-index li {
		padding-block: var(--space-5);
	}

	.project-index__title {
		margin: 0;
		color: var(--text);
		font-size: var(--text-lg);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.25;
		overflow-wrap: break-word;
	}

	.project-index__desc {
		max-width: 42rem;
		margin: 0.45rem 0 0;
		color: var(--text-muted);
		font-size: var(--text-sm);
		line-height: 1.55;
	}

	.project-index__status {
		margin: 0.75rem 0 0;
		color: var(--accent-green);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-index__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-5);
		margin: 0.35rem 0 0;
	}
</style>
