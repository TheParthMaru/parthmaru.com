---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	formatWritingDate,
	getWritingEntries,
	isPublished,
	type WritingEntry,
} from "../../lib/writing";
import "../../styles/prose.css";

export async function getStaticPaths() {
	const entries = await getWritingEntries();
	const routable = entries.filter((entry) => import.meta.env.DEV || isPublished(entry));

	return routable.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

interface Props {
	article: WritingEntry;
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
	title={`${article.data.title} — Parth Maru`}
	description={article.data.description}
>
	<article class="article">
		<header class="article__header">
			<p class="article__back">
				<a class="text-link" href="/writing">← Writing</a>
			</p>
			{
				article.data.draft ? (
					<p class="placeholder-flag">Draft</p>
				) : null
			}
			<h1>{article.data.title}</h1>
			<time datetime={article.data.date.toISOString()}>
				{formatWritingDate(article.data.date)}
			</time>
			{
				article.data.description ? (
					<p class="article__description">{article.data.description}</p>
				) : null
			}
			{
				article.data.tags.length > 0 ? (
					<ul class="tag-list">
						{article.data.tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				) : null
			}
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		width: min(100% - 2 * var(--gutter), 46rem);
		margin-inline: auto;
		padding-block: var(--space-7) var(--space-9);
		min-width: 0;
	}

	.article__back {
		margin: 0 0 var(--space-5);
	}

	.article__header h1 {
		margin: 0.75rem 0 0;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 500;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		overflow-wrap: break-word;
	}

	.article__header time {
		display: block;
		margin-top: var(--space-4);
		color: var(--text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.article__description {
		margin: var(--space-4) 0 0;
		color: var(--text-muted);
		font-size: var(--text-md);
		line-height: var(--leading-body);
	}
</style>
